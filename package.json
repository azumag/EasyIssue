{
  "name": "easyissue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "共有シートやChromeから、登録済みGitHubリポジトリへ素早くIssueを作成するPWA",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "test": "node --test",
    "check": "node scripts/check.mjs && node --test"
  },
  "devDependencies": {
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=22"
  }
}
